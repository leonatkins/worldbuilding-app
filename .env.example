# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
# Public URL of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Drizzle migrations + server queries) ---
# Postgres connection string (Supabase → Project Settings → Database → Connection
# string → URI). Used by drizzle-kit and the server-side Drizzle client.
DATABASE_URL=

# --- AI (NOT USED IN THIS PHASE) ---
# Reserved for future Claude API integration (PRD §7). No code reads this yet.
# ANTHROPIC_API_KEY=
